generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MANAGER
  ADMIN
  // Sees and manages every branch; not tied to any single branchId. Only
  // role that can create branches and the first admin for each one.
  SUPERADMIN
}

// Admin-configurable dropdown lists (managed on the /admin page).
enum OptionField {
  GOV
  CB
  FSB
  CLOSER
  STATUS
  TF
}

// Workflow state of one Contact through the cold-call queue.
enum ContactStatus {
  NEW // Новый — sitting in the shared queue, unclaimed
  IN_PROGRESS // В работе — claimed by a manager, not yet actioned
  REACHED // Дозвон — converted into an Appeal
  NOT_REACHED // Недозвон
  DECLINED // Отказ
  CALLBACK // Перезвонить — stays with the same manager, doesn't return to the queue
  ANSWERING_MACHINE // АО — автоответчик
  NOT_PUSHED // Недожал — не довёл до результата
  SKIP_ON_CODE // Скип на коде — сорвался на этапе кода
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  // SUPERADMIN-controlled toggle (Филиалы page) for the "Прозвон" module —
  // base upload + cold-call queue. Off by default for new branches — a
  // SUPERADMIN opts each branch in. Off means every /contacts endpoint
  // 403s for this branch, not just a hidden nav icon.
  contactsEnabled Boolean @default(false)
  // Per-branch override for the DaData API key used by the "ИНН ЮЛ →
  // название организации" lookup on the call card. Falls back to the
  // DADATA_API_KEY env var when unset.
  dadataApiKey    String?

  // SUPERADMIN-controlled toggle (Филиалы page) for the "Считать кош"
  // module — reads outgoing USDT TRC-20 transfers of the branch's source
  // wallets (WalletSource) from Tronscan and shows them, grouped by
  // recipient, in the statistics.
  walletCountEnabled Boolean @default(false)
  // Per-branch Tronscan API key (TRON-PRO-API-KEY) for the "Считать кош"
  // lookups — lifts the anonymous rate limit. Secret: write-only, never
  // returned to the client (only a "is it set" flag). Falls back to the
  // TRONSCAN_API_KEY env var when unset.
  tronscanApiKey     String?

  // SUPERADMIN-controlled toggle (Филиалы page) for the "Питомец" module —
  // an AI-mascot overlay that walks the tables and shows tips/emotions to
  // staff. Off by default; off means every /pet endpoint 403s for this branch.
  petEnabled Boolean @default(false)

  // SUPERADMIN-controlled toggle (Филиалы page) for the "ИНН" module — a
  // per-operator daily log of legal entities looked up by INN (via the same
  // dadataApiKey as the contacts module). Off by default; off means every
  // /inn endpoint 403s for this branch, not just a hidden dock icon.
  innEnabled Boolean @default(false)

  users         User[]
  appeals       Appeal[]
  selectOptions SelectOption[]
  userAccess    UserBranchAccess[]
  contactBatches ContactBatch[]
  contacts       Contact[]
  walletRecipients WalletRecipient[]
  walletSources    WalletSource[]
  petProfile     PetProfile?
  petRules       PetRule[]
  innEntries     InnEntry[]
}

// One row an operator logs on the "ИНН" module for a given day — a legal
// entity looked up by INN plus how many contacts came from it and how many
// were передано. Personal to the operator who created it (not a shared
// branch directory): USER sees only their own rows, ADMIN/SUPERADMIN see
// every operator's rows for the branch when building the Статистика summary.
model InnEntry {
  id   Int      @id @default(autoincrement())
  date DateTime @default(now())

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  operatorId Int
  operator   User @relation("OperatorInnEntries", fields: [operatorId], references: [id])

  inn         String
  companyName String?
  region      String?

  contactsCount    Int @default(0)
  transferredCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, date])
  @@index([operatorId, date])
  @@index([branchId, inn])
}

// A source TRON (T...) address whose OUTGOING USDT transfers are counted for
// the "Считать кош" module. A branch may have several — their outgoing is
// merged before grouping by recipient.
model WalletSource {
  id        Int      @id @default(autoincrement())
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id])
  address   String
  createdAt DateTime @default(now())

  @@unique([branchId, address])
  @@index([branchId])
}

// Maps a destination TRON address to a human name shown in the "Считать кош"
// statistics block. Outgoing transfers to an address with no mapping are
// bucketed under "Другое". Managed per branch in Админка.
model WalletRecipient {
  id        Int      @id @default(autoincrement())
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id])
  address   String
  name      String
  // A "hub" (сборный кош) — services with rotating one-time deposit addresses
  // sweep everything to one collection wallet. When set, an outgoing transfer
  // to any address that forwards (one hop) into this hub is attributed here,
  // so the throwaway deposit addresses don't each need mapping.
  isHub     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([branchId, address])
  @@index([branchId])
}

// Caches the one-hop next destinations of an address (where it forwards its
// USDT) so the hub-tracing in "Считать кош" doesn't re-query Tronscan for the
// same deposit address on every stats load. Refreshed past TTL (see service).
model WalletHopCache {
  id        Int      @id @default(autoincrement())
  branchId  Int
  address   String
  nextHops  String // comma-separated destination addresses this address sent USDT to
  checkedAt DateTime @default(now())

  @@unique([branchId, address])
  @@index([branchId])
}

// Per-branch settings for the "Питомец" mascot: its name, visual skin, and
// how chatty it is. One row per branch (created lazily with defaults).
model PetProfile {
  id         Int      @id @default(autoincrement())
  branchId   Int      @unique
  branch     Branch   @relation(fields: [branchId], references: [id])
  name       String   @default("Кеша")
  skin       String   @default("fox") // fox | robot | frog | cat
  // 0 = quiet (only on explicit checks), 1 = normal, 2 = chatty (frequent
  // ambient tips). Controls the autopilot interval on the client.
  chattiness Int      @default(1)
  // Once true, the two built-in rules have been materialized as editable
  // PetRule rows for this branch, so we never re-seed (and never resurrect
  // ones the admin deleted). See seedDefaultRules in pet.service.
  seededDefaults Boolean @default(false)
  // Stage 5 — optional AI layer: the pet asks an LLM (via OpenRouter) for a
  // couple of fresh tips based on obscured, aggregate shift stats (no PII).
  // Off by default; needs both the toggle and a key to actually call out.
  aiEnabled        Boolean @default(false)
  openRouterApiKey String?
  updatedAt  DateTime @updatedAt

  @@index([branchId])
}

// A learnable tip rule for the pet. `trigger` is one of a fixed set of
// heuristics evaluated client-side against the visible rows (e.g. no SMS,
// large deposit, "Недожал"); `message` is what the pet says when it matches.
model PetRule {
  id        Int      @id @default(autoincrement())
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id])
  trigger   String   // no_sms | big_dep | nedozhal | stalled | status | custom
  // For trigger "status": the exact branch status value to react to (a
  // SelectOption of field STATUS, per-branch/customizable). Null otherwise.
  param     String?
  message   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([branchId])
}

// Extra branches a user can switch into beyond their home branch (User.branchId).
// Set up by SUPERADMIN for managers who work cases across multiple offices.
model UserBranchAccess {
  id       Int @id @default(autoincrement())
  userId   Int
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

model SelectOption {
  id        Int         @id @default(autoincrement())
  branchId  Int
  branch    Branch      @relation(fields: [branchId], references: [id])
  field     OptionField
  value     String
  order     Int         @default(0)
  // Only meaningful for field=STATUS: the row-highlight color for appeals
  // with this status. Hex string, e.g. "#dcfce7".
  color     String?
  // Only meaningful for field=STATUS: the status a new trubka gets when
  // none is set explicitly. At most one true per branch+field — enforced
  // in the service layer (unset the others) rather than in the DB.
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@unique([branchId, field, value])
  @@index([branchId, field])
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  fullName     String
  passwordHash String
  role         Role     @default(USER)
  active       Boolean  @default(true)
  // When true, this user is hidden from the operator ranking on the
  // Statistics page (e.g. test/inactive accounts sitting at zero trubki).
  excludedFromStats Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Set once at registration time; null only for SUPERADMIN accounts, which
  // aren't scoped to any single branch.
  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // Bumped on every successful login; a JWT is only valid if its embedded
  // sessionVersion still matches. This is what makes logging in from a new
  // place invalidate any token issued before it — one active session at a
  // time per account, so a shared password stops working for the other side
  // as soon as either party logs in again.
  sessionVersion Int @default(0)

  // Employee-card fields, shown in the popup card when clicking a name in
  // a table — set by an admin from the Users page, not self-service.
  avatarUrl String?
  telegram  String?
  bio       String?

  appealsAsOperator  Appeal[]        @relation("OperatorAppeals")
  appealsAsSmsSender Appeal[]        @relation("SmsSender")
  historyEntries     AppealHistory[] @relation("HistoryChangedBy")
  innEntriesAsOperator InnEntry[]    @relation("OperatorInnEntries")
  branchAccess       UserBranchAccess[]
  loginEvents        LoginEvent[]
  uploadedContactBatches ContactBatch[] @relation("ContactBatchUploader")
  claimedContacts        Contact[]      @relation("ContactClaimedBy")

  @@index([branchId])
}

// One row per successful login — lets an admin see who's been accessing an
// account from where, e.g. to spot a shared password being used elsewhere.
model LoginEvent {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Appeal {
  id     Int      @id @default(autoincrement())
  date   DateTime @default(now())

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  operatorId Int
  operator   User @relation("OperatorAppeals", fields: [operatorId], references: [id])

  phone      String
  intake     Boolean @default(false)
  clientData String?
  dep        String?
  // Free-text time the client reports something happened (e.g. "около
  // 14:35") — distinct from createdAt, which is when this record itself
  // was saved. Edited manually in the edit drawer, never auto-filled.
  reportedTime String?

  // Free-form tags curated by admins on the /admin page — none of these are
  // live employee references anymore, just admin-curated option lists.
  gov    String?
  cb     String?
  fsb    String?
  closer String?
  tf     String?

  status      String  @default("Новое")
  description String?

  smsSentById Int?
  smsSentBy   User?     @relation("SmsSender", fields: [smsSentById], references: [id])
  smsSentAt   DateTime?

  // Optimistic-lock counter, incremented on every update. The edit form
  // sends back the version it loaded; a mismatch (someone else saved in
  // the meantime) is rejected with 409 instead of silently overwriting
  // their change and recording a history row with the wrong "before"
  // value. Quick single-field inline edits (status/tag dropdowns, intake
  // checkbox) don't send a version and stay unconditional, as before.
  version Int @default(0)

  history AppealHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete — kept in the DB so it can be restored from the trash view
  // instead of a hard `DELETE`. Null means active/not deleted.
  deletedAt DateTime?

  // Set when this appeal was created by converting a cold-call Contact
  // (see Contact.appealId below) rather than logged directly.
  contact Contact?

  @@index([branchId])
  @@index([operatorId])
  @@index([status])
  @@index([date])
  @@index([deletedAt])
}

model AppealHistory {
  id     Int    @id @default(autoincrement())
  appeal Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  appealId Int

  changedBy   User @relation("HistoryChangedBy", fields: [changedById], references: [id])
  changedById Int

  field      String
  fieldLabel String
  oldValue   String?
  newValue   String?

  changedAt DateTime @default(now())

  @@index([appealId])
}

// One uploaded client-base file — a batch of Contacts to cold-call through.
model ContactBatch {
  id           Int      @id @default(autoincrement())
  branchId     Int
  branch       Branch   @relation(fields: [branchId], references: [id])
  fileName     String
  totalCount   Int
  uploadedById Int
  uploadedBy   User     @relation("ContactBatchUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  contacts Contact[]

  @@index([branchId])
}

// One phone number from an uploaded batch, worked through the shared
// cold-call queue by managers until it either becomes an Appeal (REACHED)
// or is marked NOT_REACHED/DECLINED. CALLBACK stays claimed by the same
// manager instead of returning to the queue.
model Contact {
  id       Int    @id @default(autoincrement())
  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  batchId Int
  batch   ContactBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  phone    String
  fullName String?
  // Any other columns from the uploaded file besides phone/name, flattened
  // into a single "Label: value; Label: value" string — shown to the
  // manager as "Доп. инфа" on the call card.
  extraInfo String?

  status ContactStatus @default(NEW)

  claimedById Int?
  claimedBy   User?     @relation("ContactClaimedBy", fields: [claimedById], references: [id])
  claimedAt   DateTime?

  resultNote String?

  appealId Int?    @unique
  appeal   Appeal? @relation(fields: [appealId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([batchId])
  @@index([claimedById])
}

// Admin-curated "город → адрес СФР" reference list, used by the call card
// to show the local social fund (СФР) office address derived from a
// client's "Адрес" field. Not branch-scoped — a city's office address is
// the same regardless of which branch is calling.
model SocialFundOffice {
  id      Int    @id @default(autoincrement())
  city    String @unique
  address String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
